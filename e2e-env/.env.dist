COMPOSE_PROJECT_NAME=e2e

CI=false

## myTun Credentials
ACCOUNT_TAG=xxxx
TUNNEL_SECRET=xxxx
TUNNEL_ID=xxxx

PS_DOMAIN=prestashop.xxxx-mytun.prestashop.name

# Prestashop
DOCKER_IMAGE_PRESTASHOP=prestashop/prestashop-flashlight:latest
DOCKER_VERSION_MARIADB=lts

# Modules
PS_ACCOUNTS_VERSION=v6.3.2
ACCOUNTS_FAKE_ONBOARDING=false
ACCOUNTS_EMAIL=xxxx
ACCOUNTS_PASSWORD=xxxx

# Infrastructure port binding on the host
HOST_PORT_BIND_PRESTASHOP=8000
HOST_PORT_BIND_MYSQL=3306
HOST_PORT_BIND_PHP_MY_ADMIN=6060

GITHUB_API_TOKEN=xxxx